generator client {
  provider = "prisma-client-js"
}
 
datasource db {
  provider = "sqlite"
}
 
model Tag {
  id   Int    @id @default(autoincrement())
  name String @unique
}

model Note {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  tag       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
